{
  "expo": {
    "name": "Dialogue",
    "slug": "dialogue",
    "owner": "velionapss-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dialogue",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B12",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.raheel.dialogue",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.raheel.dialogue",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-brightness",
      [
        "@siteed/audio-studio",
        {
          "enableBackgroundAudio": true,
          "enableNotifications": true,
          "enablePhoneStateHandling": true,
          "enableDeviceDetection": false,
          "iosBackgroundModes": {
            "useAudio": true
          }
        }
      ],
      "expo-asset"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/c4d60f47-e555-4886-8e94-802ae2dc9cec"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c4d60f47-e555-4886-8e94-802ae2dc9cec"
      },
      "supabaseUrl": "https://gkdbohzpvrjustozyroi.supabase.co",
      "supabaseAnonKey": "sb_publishable_U1JSUqpB-cvyH0Dkqxz80Q_WY8s6cB9"
    }
  }
}
